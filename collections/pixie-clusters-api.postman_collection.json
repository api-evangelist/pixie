  "info": {
    "_postman_id": "41f57d1d-3041-49b6-9286-c9ed849ea105",
    "name": "Pixie Clusters API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": {
      "content": "The Pixie API provides programmatic access to the Pixie Kubernetes observability platform. It enables listing and managing clusters, executing PxL scripts to query telemetry data collected via eBPF, and retrieving results including full-body application requests, resource metrics, and network data without requiring manual instrumentation.\n\nContact Support:\n Name: Pixie Community",
      "type": "text/plain"
    }
